  <path d="M3 9 16 15v14L3 23z" fill="#0d1a24"/>
  <path d="M16 3 29 9 16 15 3 9z" fill="#2a475e"/>
  <path d="M16 3 29 9v14L16 29 3 23V9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <path d="M8 19.5a5 5 0 0 1 5-5 4.6 4.6 0 0 1 4.3 2.9" fill="none" stroke="#66c0f4" stroke-width="2.2" stroke-linecap="round"/>
